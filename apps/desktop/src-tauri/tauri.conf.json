{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LexField",
  "version": "0.1.0",
  "identifier": "com.lexfield.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "LexField · 四六级全量词汇记忆",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
